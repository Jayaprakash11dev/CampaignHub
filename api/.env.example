# Local Postgres from docker-compose (host port 5434).
# For Neon use the direct (not pooled) connection string, e.g.
# postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://campaignhub:campaignhub@localhost:5434/campaignhub?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
PORT=3000

# Allowed frontend origins, comma-separated. Leave empty to allow any origin
# (fine locally). In production set it to the Vercel URL.
# CORS_ORIGIN="https://campaignhub.vercel.app"
